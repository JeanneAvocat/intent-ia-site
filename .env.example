# URL de production du site (sans slash final). Utilisée pour metadataBase,
# canonical, sitemap, robots, Open Graph.
NEXT_PUBLIC_SITE_URL=https://intent-ia.com

# --- Newsletter "Foudre IA" ------------------------------------------------
# PLACEHOLDER : aucun ESP (Brevo, Mailchimp, Kit...) n'est branché à ce stade.
# Tant que cette variable est vide, la page /foudre-ia affiche un formulaire
# "mailto" de secours (voir components/site/NewsletterForm.tsx). Renseigner
# l'URL d'intégration du formulaire ESP ici dès qu'il existe.
# NEXT_PUBLIC_NEWSLETTER_FORM_URL=https://xxxx.brevo.com/xxxxx

# Code de vérification Google Search Console (balise HTML).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics sans cookie (Plausible) : domaine déclaré.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=intent-ia.com
